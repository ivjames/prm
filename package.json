{
  "name": "prm",
  "version": "0.1.0",
  "private": true,
  "description": "Personal relationship management — auto-updating contact timelines, cadence reminders, voice-note capture. Hybrid: Supabase backend, web PWA + workers served from the lab980 droplet.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
