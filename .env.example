# PRM configuration — copy to .env and fill in.
# lab980 convention: config lives in the app dir (this file), not /etc.
# provision-site seeds PORT here; everything else is added by hand on deploy.

# --- web/API server ---
# Local port nginx proxies to. provision-site picks the next free 8060+ and
# writes it here automatically; keep whatever it chose.
PORT=8060

# Public origin the web client is served from (used for OAuth redirects, CORS).
PUBLIC_ORIGIN=https://prm.lab980.com

# --- Supabase (backend: managed Postgres + Auth + RLS) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Anon key — safe to ship to the web client (RLS enforces per-user isolation).
SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS; used by workers + API.
# Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Claude API) ---
# Haiku-tier for extraction/summarization, Sonnet-tier for the priority digest.
ANTHROPIC_API_KEY=

# --- Speech-to-text (voice capture; batch mode) ---
DEEPGRAM_API_KEY=

# --- Google data-access OAuth (Gmail + Calendar ingestion) ---
# Login OAuth is handled by Supabase Auth; these are the separate data-access
# credentials whose refresh tokens land in the encrypted token vault.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- worker cadence ---
# How often the ingestion poll runs (cron syntax). v1 fallback is polling;
# webhook/push wiring comes later.
INGEST_CRON=*/15 * * * *
# How often the cadence/overdue engine recomputes and fires reminders.
CADENCE_CRON=0 * * * *
